---
const links = [{ href: "/resume", label: "Résumé" }];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav>
	<a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}>AlexGravely.Dev</a>
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href} aria-current={path === link.href ? "page" : undefined}>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	nav {
		position: sticky;
		top: 0;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.1rem 0.5rem;
		background-color: var(--bg-primary);
	}
	a {
		text-decoration: none;
		transition: color 0.25s ease;
	}
	a:hover {
		color: var(--text-secondary);
	}
	.brand {
		font-size: 1.25rem;
	}
	ul {
		display: flex;
		font-size: clamp(0.7rem, -0.85rem + 8.333vw, 0.9rem);
	}
	li + li {
		border-left: 1.5px solid var(--text-primary);
		padding-left: 0.5rem;
		margin-left: 0.5rem;
	}
	@media (max-width: 599px) {
		nav {
			justify-content: center;
		}
		.brand {
			font-size: inherit;
		}
	}
</style>
