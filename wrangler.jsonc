{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "alexgravely-dev",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Staging hostname while the old site still serves alexgravely.dev.
	// Needs the alexgravely.dev zone on the same Cloudflare account; Wrangler
	// creates the DNS record and certificate on deploy.
	"routes": [{ "pattern": "astro.alexgravely.dev", "custom_domain": true }],
	// Shared by EmDash and the invoice tables (see docs/rebuild-plan.md, section 6).
	// `database_id` is filled in when the D1 database is created at deploy time.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "alexgravely-dev",
			// Invoice tables only; EmDash manages its own schema.
			"migrations_dir": "migrations",
		},
	],
	// EmDash media storage.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "alexgravely-dev-media",
		},
	],
	// Cloudflare Email Sending: invoice links, receipts, and payment notices.
	// The sender domain must be onboarded under Email Service before deploy.
	"send_email": [{ "name": "EMAIL" }],
	// Public configuration. Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
	// PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID, optional TURNSTILE_SECRET_KEY) are set with `wrangler secret put`
	// and, locally, in .dev.vars (see .dev.vars.example).
	"vars": {
		"STRIPE_API_BASE": "https://api.stripe.com",
		// Switch to https://api-m.paypal.com and the live client ID at launch.
		"PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com",
		"PAYPAL_CLIENT_ID": "",
		"EMAIL_FROM": "invoices@alexgravely.dev",
		"EMAIL_FROM_NAME": "Alex Gravely",
		// Receives payment notices, double-payment alerts, and contact messages.
		"NOTIFY_EMAIL": "antitcb@gmail.com",
		// Optional Cloudflare Turnstile on /contact. Leave empty to rely on the
		// honeypot only; when set, TURNSTILE_SECRET_KEY must be a secret.
		"TURNSTILE_SITE_KEY": "",
	},
	// EmDash scheduled publishing and maintenance.
	"triggers": {
		"crons": ["* * * * *"],
	},
}
