# Copy to .dev.vars for local development. Never commit .dev.vars.
# Use Stripe test-mode keys and PayPal sandbox credentials.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...
# Optional overrides of the values in wrangler.jsonc "vars":
# PAYPAL_CLIENT_ID=...
# Optional: Turnstile test keys that always pass (see Cloudflare's Turnstile testing docs).
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
